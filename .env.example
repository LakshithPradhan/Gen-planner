# GEMINI_API_KEY: Used for Google Gemini AI calls (auto-injected in AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional. Used for Claude API generation (/api/plan and /api/chat).
ANTHROPIC_API_KEY="sk-ant-api03-..."

# CLAUDE_MODEL: Model alias to use with Anthropic SDK (default: claude-3-5-sonnet-20241022 or claude-sonnet-5-5)
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (default: 3000)
PORT=3000
